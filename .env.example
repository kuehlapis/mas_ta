# Backend
DOCQA_DB_PATH=/data/docqa.sqlite3
DOCQA_ES_URL=http://elasticsearch:9200
DOCQA_REDIS_URL=redis://redis:6379/0
DOCQA_ES_INDEX=docqa_chunks
DOCQA_REDIS_INDEX=idx:docqa_chunks
DOCQA_REDIS_PREFIX=docqa:chunk:

# Hybrid ranking: Reciprocal Rank Fusion, then cross-encoder reranking of the top candidates
DOCQA_RRF_K=60
DOCQA_RRF_KEYWORD_WEIGHT=1.0
DOCQA_RRF_SEMANTIC_WEIGHT=1.0
DOCQA_RERANK=true
DOCQA_RERANK_CANDIDATES=20
DOCQA_RERANK_PER_RETRIEVER=5
DOCQA_RERANK_MODEL=ms-marco-TinyBERT-L-2-v2
